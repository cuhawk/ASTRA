# ASTRA backend env. Copy to .env and fill in.
# All vars use the ASTRA_ prefix.

# --- DB ---
ASTRA_DB_PATH=./astra.db

# --- Redis (quota counter) ---
ASTRA_REDIS_URL=redis://localhost:6379/0

# --- Sessions ---
# Random 32+ byte string; rotates all sessions when changed.
ASTRA_SESSION_SECRET=
ASTRA_SESSION_MAX_AGE_S=1209600
ASTRA_SESSION_COOKIE_NAME=astra_sid
ASTRA_SESSION_COOKIE_SECURE=true

# --- GitHub OAuth ---
# Create at https://github.com/settings/developers (OAuth App).
ASTRA_GITHUB_CLIENT_ID=
ASTRA_GITHUB_CLIENT_SECRET=
ASTRA_GITHUB_REDIRECT_URI=https://your-domain.example/auth/github/callback

# --- Anthropic-key vault ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ASTRA_VAULT_KEK_HEX=

# --- Quota ---
ASTRA_FREE_TIER_DAILY_LIMIT=100

# --- LLM proxy ---
# Gemini key owned by ASTRA (free tier). Get one at https://aistudio.google.com/
ASTRA_GEMINI_API_KEY=
ASTRA_GEMINI_MODEL=gemini-3.1-flash-lite
ASTRA_GEMINI_EMBED_MODEL=text-embedding-004
# Anthropic models for Pro tier (users supply their own key via the vault).
ASTRA_ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5-20250929
ASTRA_ANTHROPIC_OPUS_MODEL=claude-opus-4-5-20250929
# Global free-tier daily spend ceiling (USD).
ASTRA_DAILY_SPEND_CAP_USD=20.0

# --- Public URLs ---
# Where the frontend lives. Used for OAuth callback redirect + CORS origin.
ASTRA_BASE_URL=http://127.0.0.1:3000
ASTRA_FRONTEND_ORIGIN=http://127.0.0.1:3000
