# ASTRA backend env. Copy to .env and fill in.
# All vars use the ASTRA_ prefix.

# --- DB ---
ASTRA_DB_PATH=./astra.db

# --- Redis (quota counter) ---
ASTRA_REDIS_URL=redis://localhost:6379/0

# --- Sessions ---
# Random 32+ byte string; rotates all sessions when changed.
ASTRA_SESSION_SECRET=
ASTRA_SESSION_MAX_AGE_S=1209600
ASTRA_SESSION_COOKIE_NAME=astra_sid
ASTRA_SESSION_COOKIE_SECURE=true

# --- GitHub OAuth ---
# Create at https://github.com/settings/developers (OAuth App).
ASTRA_GITHUB_CLIENT_ID=
ASTRA_GITHUB_CLIENT_SECRET=
ASTRA_GITHUB_REDIRECT_URI=https://your-domain.example/auth/github/callback

# --- Anthropic-key vault ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ASTRA_VAULT_KEK_HEX=

# --- Quota ---
ASTRA_FREE_TIER_DAILY_LIMIT=100

# --- Public base URL ---
ASTRA_BASE_URL=https://your-domain.example
